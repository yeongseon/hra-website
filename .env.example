# 로컬 개발용 예시입니다. 실제 자격 증명은 커밋하지 않는 .env에 보관하세요.
# 준비 순서: docs/getting-started/clone-and-setup.md
# 아래 주소·비밀값을 그대로 쓰지 말고 개발 전용 값으로 바꿉니다.
DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/hra?sslmode=require
AUTH_SECRET=

# 사용할 OAuth 제공자만 개발용 ID/secret을 채웁니다. 빈값이면 해당 제공자를 켜지 않습니다.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
AUTH_KAKAO_EMAIL_SCOPE=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 공개 이미지·포스터 등 업로드 기능을 검증할 때 개발 전용 저장소를 연결합니다.
BLOB_READ_WRITE_TOKEN=
# 보호 자료용 별도 Private Blob을 연결하고 기존 파일 이전을 확인한 뒤 전환합니다.
RESOURCE_PRIVATE_BLOB_HOST=
RESOURCE_PRIVATE_READ_WRITE_TOKEN=
RESOURCE_PRIVATE_BLOB_ENABLED=false

# 운영 절차: docs/operations/rate-limits.md 및 docs/DEPLOYMENT.md
# 예약 작업을 사용하는 환경마다 서로 다른 긴 비밀값을 설정합니다.
CRON_SECRET=
# 상태 확인 API의 상세 응답을 볼 때 설정합니다. 기본 DB 점검은 이 값 없이도 수행합니다.
HEALTH_CHECK_SECRET=

# 학사 정책 확정 및 학사 테이블·함수 적용 후 공개합니다. 기본값은 준비 안내만 표시합니다.
ACADEMIC_ENABLED=false
# 개인 과제는 명시적으로 연결한 Private Blob만 사용합니다. 공개 저장소로 대체하지 않습니다.
ACADEMIC_SUBMISSION_BLOB_HOST=
ACADEMIC_SUBMISSION_READ_WRITE_TOKEN=
ACADEMIC_UPLOADS_ENABLED=false
# 정리 실행과 실물 삭제는 각각 별도 승인합니다. 기본값은 비활성·dry-run입니다.
ACADEMIC_UPLOAD_CLEANUP_ENABLED=false
ACADEMIC_UPLOAD_CLEANUP_DELETE_ENABLED=false
# 학사 운영 책임자의 검증된 앱 계정 UUID. 이메일·ADMIN 역할로 자동 선택하지 않습니다.
ACADEMIC_APPROVER_USER_ID=
# #142 보존·파기 정책 및 운영 승인 전에는 false를 유지합니다.
ACADEMIC_ENROLLMENT_WRITES_ENABLED=false

# 아래 값은 일회성 관리 명령이 필요할 때만 설정합니다. 기본 앱 실행에는 필요 없습니다.
# 관리자 초기화·승격 인자와 동작: docs/ADMIN-GUIDE.md
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=

# 로컬 PostgreSQL 테스트와 psql 실행 파일 위치: docs/QUALITY-GATE.md
# HRA_TEST_PG_BIN=/path/to/postgresql/bin
# HRA_PSQL_BIN=/path/to/postgresql/bin/psql

# 파일 정리 전에 실제로 콘텐츠 쓰기를 중단했음을 확인하는 값입니다.
# 이 값을 설정하는 것만으로 앱의 쓰기가 중단되지는 않습니다.
# docs/operations/markdown-image-ownership.md의 절차에 따라 필요한 실행에만 지정합니다.
# HRA_CONTENT_WRITES_STOPPED=1

