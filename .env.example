# 로컬 개발용 예시입니다. 실제 자격 증명은 .env에만 보관하세요.
DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/hra?sslmode=require
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret
AUTH_KAKAO_ID=replace-with-kakao-client-id
AUTH_KAKAO_SECRET=replace-with-kakao-client-secret
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token
# 보호 자료용 별도 Private Blob 저장소를 연결한 뒤에만 전환 플래그를 켭니다.
RESOURCE_PRIVATE_BLOB_HOST=
RESOURCE_PRIVATE_READ_WRITE_TOKEN=
RESOURCE_PRIVATE_BLOB_ENABLED=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 필요할 때만 설정합니다.
HEALTH_CHECK_SECRET=
AUTH_KAKAO_EMAIL_SCOPE=false
# 학사 운영 책임자의 검증된 앱 계정 UUID. 이메일·ADMIN 역할로 자동 선택하지 않습니다.
ACADEMIC_APPROVER_USER_ID=
# #142 보존·파기 정책 및 운영 승인 전에는 false를 유지합니다.
ACADEMIC_ENROLLMENT_WRITES_ENABLED=false
