{
  "name": "@hra/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --runInBand",
    "doctor": "expo-doctor",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "build:android:debug": "node scripts/build-android.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@tanstack/react-query": "5.105.3",
    "expo": "58.0.23",
    "expo-constants": "58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "58.0.4",
    "expo-file-system": "58.0.13",
    "expo-font": "~58.0.11",
    "expo-intent-launcher": "~58.0.3",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "expo-secure-store": "58.0.2",
    "expo-sharing": "58.0.22",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-expo": "58.0.4",
    "expo-doctor": "1.21.6",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "openapi-typescript": "7.13.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
