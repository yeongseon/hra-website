{
  "name": "hra-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --version",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:academic-g1": "node scripts/verify-academic-g1.mjs",
    "verify:auth-proxy": "node scripts/verify-auth-proxy-http.mjs",
    "issues:check": "node scripts/check-process-format.mjs",
    "spell-check": "node scripts/spell-check.mjs",
    "spell-fix": "node scripts/spell-check.mjs --fix",
    "seed-admin": "node --env-file=.env scripts/seed-admin.mjs",
    "seed-cohorts": "node --env-file=.env scripts/seed-cohorts.mjs",
    "db:push": "drizzle-kit push",
    "academic:backfill": "node --env-file=.env scripts/backfill-academic-enrollments.mjs",
