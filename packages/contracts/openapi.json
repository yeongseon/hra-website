{
  "openapi": "3.1.1",
  "info": {
    "title": "HRA 공용 API",
    "version": "0.1.0",
    "description": "구현된 공용 HTTP 경로만 기록합니다. 인증 방식과 모바일 지원 상태는 각 경로의 설명에 따릅니다."
  },
  "paths": {
    "/api/v1/notices": {
      "get": {
        "operationId": "listPublishedNotices",
        "summary": "발행된 공지사항 목록 조회",
        "description": "초안은 포함하지 않습니다. 알 수 없거나 중복된 query key는 400으로 거부합니다. 전체 범위를 넘는 페이지는 요청한 page 번호와 빈 notices 배열을 반환합니다. Web 화면의 마지막 페이지 보정 규칙과 구분합니다.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "1부터 시작하는 요청 페이지 번호입니다. pageSize와 계산한 OFFSET이 안전한 정수 범위를 넘으면 400으로 거부합니다.",
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "한 번에 조회할 공지 수입니다.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "앞뒤 공백을 제거한 뒤 제목에서 대소문자를 구분하지 않고 검색합니다.",
            "schema": { "type": "string", "maxLength": 100 }
          }
        ],
        "responses": {
          "200": {
            "description": "발행 공지의 최소 DTO 목록과 요청 페이지 정보",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/NoticeListResponse" } }
            }
          },
          "400": {
            "description": "query 입력이 잘못되었거나 중복·미등록 key가 있음",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/InvalidInputError" } }
            }
          },
          "503": {
            "description": "저장소 오류 등으로 현재 공지 목록을 제공할 수 없음",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/UnavailableError" } }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "getCurrentUser",
        "summary": "현재 로그인한 사용자의 프로필 조회",
        "description": "현재는 Auth.js Web 세션 쿠키가 필요한 경로입니다. 쿠키 이름은 환경·보안 접두어·분할 여부에 따라 달라져 고정하지 않습니다. 모바일 Bearer 인증은 아직 지원하지 않습니다. PENDING 사용자도 자신의 프로필만 조회할 수 있으며 자료 접근 권한을 얻지 않습니다. query key는 허용하지 않습니다.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "현재 로그인한 사용자 본인의 공개 가능 프로필",
            "headers": {
              "Cache-Control": {
                "description": "개인 프로필 응답을 공유 캐시와 로컬 캐시에 저장하지 않습니다.",
                "schema": { "type": "string", "const": "private, no-store" }
              }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/MeResponse" } }
            }
          },
          "400": {
            "description": "허용되지 않은 query key가 있음",
            "headers": {
              "Cache-Control": {
                "description": "개인 프로필 오류도 캐시하지 않습니다.",
                "schema": { "type": "string", "const": "private, no-store" }
              }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/InvalidInputError" } }
            }
          },
          "401": {
            "description": "세션이 없거나 계정 삭제·역할 변경으로 현재 로그인 상태가 유효하지 않음",
            "headers": {
              "Cache-Control": {
                "description": "인증 오류를 캐시하지 않습니다.",
                "schema": { "type": "string", "const": "private, no-store" }
              }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/UnauthenticatedError" } }
            }
          },
          "503": {
          "description": "Auth.js가 명시적으로 전파한 오류 또는 세션 확인 뒤 별도 프로필 저장소 조회 장애가 발생함",
            "headers": {
              "Cache-Control": {
                "description": "저장소 오류를 캐시하지 않습니다.",
                "schema": { "type": "string", "const": "private, no-store" }
              }
            },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/UnavailableError" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MeUser": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "email", "role", "cohortId", "imageUrl"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": ["string", "null"], "minLength": 1 },
          "email": { "type": ["string", "null"], "minLength": 1 },
          "role": { "type": "string", "enum": ["ADMIN", "FACULTY", "MEMBER", "PENDING"] },
          "cohortId": { "type": ["string", "null"], "format": "uuid" },
          "imageUrl": { "type": ["string", "null"], "minLength": 1 }
        }
      },
      "MeResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user"],
        "properties": {
          "user": { "$ref": "#/components/schemas/MeUser" }
        }
      },
      "NoticeSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "excerpt", "pinned", "viewCount", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string", "minLength": 1 },
          "excerpt": { "type": "string" },
          "pinned": { "type": "boolean" },
          "viewCount": { "type": "integer", "minimum": 0 },
          "createdAt": { "$ref": "#/components/schemas/UtcTimestamp" },
          "updatedAt": { "$ref": "#/components/schemas/UtcTimestamp" }
        }
      },
      "UtcTimestamp": {
        "type": "string",
        "format": "date-time",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$",
        "description": "UTC 밀리초 정밀도 ISO-8601 wire timestamp입니다."
      },
      "PageMeta": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "pageSize", "totalCount", "totalPages", "hasNextPage", "hasPreviousPage"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "pageSize": { "type": "integer", "minimum": 1, "maximum": 50 },
          "totalCount": { "type": "integer", "minimum": 0 },
          "totalPages": { "type": "integer", "minimum": 0 },
          "hasNextPage": { "type": "boolean" },
          "hasPreviousPage": { "type": "boolean" }
        }
      },
      "NoticeListResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["notices", "page"],
        "properties": {
          "notices": {
            "type": "array",
            "maxItems": 50,
            "items": { "$ref": "#/components/schemas/NoticeSummary" }
          },
          "page": { "$ref": "#/components/schemas/PageMeta" }
        }
      },
      "InvalidInputError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "requestId"],
            "properties": {
              "code": { "type": "string", "const": "INVALID_INPUT" },
              "message": { "type": "string", "minLength": 1 },
              "requestId": { "type": "string", "format": "uuid" }
            }
          }
        }
      },
      "UnauthenticatedError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "requestId"],
            "properties": {
              "code": { "type": "string", "const": "UNAUTHENTICATED" },
              "message": { "type": "string", "minLength": 1 },
              "requestId": { "type": "string", "format": "uuid" }
            }
          }
        }
      },
      "UnavailableError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "requestId"],
            "properties": {
              "code": { "type": "string", "const": "UNAVAILABLE" },
              "message": { "type": "string", "minLength": 1 },
              "requestId": { "type": "string", "format": "uuid" }
            }
          }
        }
      }
    }
  }
}
